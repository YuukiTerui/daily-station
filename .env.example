# Weather Station Configuration
# Copy this file to .env.local to customize your station settings.
# Keep actual coordinates private to prevent exposing exact location on GitHub.

VITE_STATION_NAME="Tokyo"
VITE_LATITUDE="35.6895"
VITE_LONGITUDE="139.6917"
VITE_TIMEZONE="Asia/Tokyo"

# Google Calendar iCal URL (Private Address)
# Googleカレンダーの設定 -> 対象カレンダー -> 「カレンダーの統合」 -> 「iCal 形式の非公開アドレス」を貼り付けます
# 未設定時はデモ用のモック予定が表示されます
GOOGLE_CALENDAR_ICAL_URL=""
